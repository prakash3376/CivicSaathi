# Copy this file to `.env` and adjust. Real environment variables take precedence over `.env`.

# development | test | staging | production
# The interactive API docs (/docs) are disabled when this is "production".
APP_ENV=development

# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# Browser origins allowed to call the API directly, comma-separated. "*" is rejected in production.
# In development the Vite dev server proxies /api to this backend, so this matters only for
# direct cross-origin calls (for example a phone on your LAN or a separately hosted frontend).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Document ingestion (python -m app.cli ...) ---

# Where downloaded documents, the vector index (ChromaDB) and the embedding model are kept.
# A relative path is resolved against the backend folder. Safe to delete: `ingest` rebuilds it.
DATA_DIR=storage

# Multilingual model that turns passages and questions into vectors (Hindi, Bengali, ... and
# English). The first `ingest` downloads about 490 MB once. Changing it means re-embedding
# everything: run `python -m app.cli ingest --rebuild`.
EMBEDDING_MODEL=intfloat/multilingual-e5-small

# Give up on a download after this many seconds, and refuse documents larger than this (SPEC: 25).
FETCH_TIMEOUT_SECONDS=30
MAX_DOCUMENT_MB=25

# Largest request body the API will read, in bytes (default 64 KiB). Bigger ones get HTTP 413.
MAX_REQUEST_BODY_BYTES=65536

# --- AI assistant (Google Gemini) ---

# Your Gemini API key (https://aistudio.google.com/apikey). Without one the assistant is off:
# asking returns "not set up" and everything else keeps working. Put the real key only in your
# own `.env` (or the environment), never in this file, and never commit it.
# PRIVACY: each question, and the passages sent with it, go to Google. On the free tier Google may
# use that data to improve its products; the paid tier does not. Use a paid key for real users.
GEMINI_API_KEY=

# The model to ask. Use one your key can access; a "flash" model balances speed and cost.
GEMINI_MODEL=gemini-3.6-flash

# Optional: a different API address (a gateway, a regional endpoint, a test double). Blank = Google.
GEMINI_BASE_URL=

# Give up on the model after this many seconds, and cap the length of one reply (in tokens).
GEMINI_TIMEOUT_SECONDS=45
GEMINI_MAX_OUTPUT_TOKENS=4096

# The most one question may wait for the model in all, retries included (keep it under the 60 s the
# browser waits). After LLM_BREAKER_THRESHOLD failures in a row (provider down or rate-limited) the
# model is not asked for LLM_BREAKER_COOLDOWN_SECONDS: visitors get the matching official passages
# at once instead of waiting for each question to time out.
GEMINI_DEADLINE_SECONDS=50
LLM_BREAKER_THRESHOLD=5
LLM_BREAKER_COOLDOWN_SECONDS=30

# Optional: how hard the model thinks before answering: minimal | low | medium | high. Lower is
# faster and cheaper. Blank uses the model's own default. Not every model supports this setting.
GEMINI_THINKING_LEVEL=

# The longest question accepted (characters), and how many questions one client address may ask
# per minute (0 switches the limit off). Behind a reverse proxy, start the server with
# --proxy-headers so that each visitor is counted on their own address, not the proxy's.
ASSISTANT_MAX_QUESTION_CHARS=500
ASSISTANT_RATE_LIMIT_PER_MINUTE=20

# Opens the knowledge-base health page, GET /api/v1/admin/knowledge, to whoever sends this value in
# the X-Admin-Token header. Leave empty and that page does not exist. Use a long random string.
ADMIN_TOKEN=

# --- Performance and observability (these are the defaults; set to false only to measure) ---
# Keep the result of reading every passage's metadata (the list of sources) until the index changes.
CACHE_ENABLED=true
# Compress JSON replies of 1 KB or more for clients that accept it.
COMPRESS_RESPONSES=true
# One log line per request: method, route, status, milliseconds. Never the query string or body.
ACCESS_LOG=true
# Wrong admin-token attempts one client address may make per minute; 0 switches the limit off.
ADMIN_RATE_LIMIT_PER_MINUTE=10
